# Mastra Event Intelligence API Configuration

# LLM Provider (required - at least one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# AI Tickets Backend (required)
AITICKETS_API_URL=http://localhost:8000
AITICKETS_API_KEY=

# Web Search (required for Research Agent)
SERPAPI_KEY=
EXA_API_KEY=

# Meta Ads (optional - for Media Buyer Agent)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_APP_ID=
META_APP_SECRET=

# Image Generation (optional - for Creative Director Agent)
OPENAI_IMAGE_API_KEY=

# External Platforms (optional - for Publishing Agent)
EVENTBRITE_API_KEY=
EVENTBRITE_ORG_ID=

# Database
DATABASE_URL=file:./mastra.db

# Server
PORT=3002
NODE_ENV=development
