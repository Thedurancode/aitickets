# Production Environment Configuration

# Database (PostgreSQL in production)
DATABASE_URL=postgresql://user:password@localhost/aitickets

# Application
BASE_URL=https://ai-tickets.fly.dev
UPLOADS_DIR=/app/data/uploads

# Logging (structured JSON for production)
LOG_LEVEL=INFO
LOG_FORMAT=structured

# Branding
ORG_NAME=Toronto Raptors
ORG_COLOR=#CE1141
ORG_LOGO_URL=https://upload.wikimedia.org/wikipedia/en/3/36/Toronto_Raptors_logo.svg

# Notifications
REMINDER_HOURS_BEFORE=24

# Authentication (REQUIRED in production)
MCP_API_KEY=your-secure-mcp-key
ADMIN_API_KEY=your-secure-admin-key

# CORS (restrict to your domains)
CORS_ORIGINS=https://ai-tickets.fly.dev,https://yourdomain.com

# API Keys (use production keys)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key

RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=tickets@yourdomain.com

TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# LLM Routing
OPENROUTER_API_KEY=sk-or-your-openrouter-key
LLM_ROUTER_MODEL=openai/gpt-4o-mini

# Optional Services
POSTIZ_API_KEY=your_postiz_api_key
POSTIZ_URL=https://api.postiz.com

OPENAI_API_KEY=sk-your-openai-key
GEMINI_API_KEY=your-gemini-key

OWNER_PHONE=+1234567890
