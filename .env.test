# Test Environment Configuration

# Database (in-memory SQLite for tests)
DATABASE_URL=sqlite:///:memory:

# Application
BASE_URL=http://localhost:8000
UPLOADS_DIR=test_uploads

# Logging (minimal for tests)
LOG_LEVEL=WARNING
LOG_FORMAT=human

# Branding
ORG_NAME=Test Organization
ORG_COLOR=#000000
ORG_LOGO_URL=https://example.com/logo.png

# Notifications
REMINDER_HOURS_BEFORE=24

# Authentication (disabled for tests)
MCP_API_KEY=
ADMIN_API_KEY=

# CORS
CORS_ORIGINS=*

# API Keys (use test/mock values)
STRIPE_SECRET_KEY=sk_test_mock
STRIPE_WEBHOOK_SECRET=whsec_mock
STRIPE_PUBLISHABLE_KEY=pk_test_mock

RESEND_API_KEY=re_mock
FROM_EMAIL=test@example.com

TWILIO_ACCOUNT_SID=test_sid
TWILIO_AUTH_TOKEN=test_token
TWILIO_PHONE_NUMBER=+11111111111

# LLM Routing (mock for tests)
OPENROUTER_API_KEY=sk-or-mock
LLM_ROUTER_MODEL=openai/gpt-4o-mini

# Optional Services (all empty for tests)
POSTIZ_API_KEY=
POSTIZ_URL=https://api.postiz.com

OPENAI_API_KEY=
GEMINI_API_KEY=

OWNER_PHONE=
