# Development Environment Configuration

# Database (SQLite for local dev)
DATABASE_URL=sqlite:///./tickets.db

# Application
BASE_URL=http://localhost:8000
UPLOADS_DIR=uploads

# Logging (human-readable for development)
LOG_LEVEL=DEBUG
LOG_FORMAT=human

# Branding
ORG_NAME=Toronto Raptors
ORG_COLOR=#CE1141
ORG_LOGO_URL=https://upload.wikimedia.org/wikipedia/en/3/36/Toronto_Raptors_logo.svg

# Notifications
REMINDER_HOURS_BEFORE=24

# Authentication (disabled for local dev)
MCP_API_KEY=
ADMIN_API_KEY=

# CORS (allow all in development)
CORS_ORIGINS=*

# API Keys (use test keys in development)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=tickets@yourdomain.com

TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# LLM Routing
OPENROUTER_API_KEY=sk-or-your-openrouter-key
LLM_ROUTER_MODEL=openai/gpt-4o-mini

# Optional Services
POSTIZ_API_KEY=
POSTIZ_URL=https://api.postiz.com

OPENAI_API_KEY=
GEMINI_API_KEY=

OWNER_PHONE=

SHOW_HEADER_LINKS=false
